#!name=G1 ACQ
#!desc=30TB Ultra 默认三个月一折(90p)，20TB 保持1个月免费试用；2TB 12个月优惠测试；被动采集原始 SKU 与响应诊断；本机报告与 JSON 导出
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/waydone/g1-acq/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/waydone/g1-acq/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
